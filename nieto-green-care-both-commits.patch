+/* ---------- tables ---------- */
+.table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 1rem; overflow: hidden; box-shadow: var(--shadow-sm) }
+.table th, .table td { text-align: left; padding: .8rem; border-bottom: 1px solid var(--line) }
+.table th { font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; color: #59675f }
+
+.badge {
+  display: inline-block;
+  padding: .2rem .6rem;
+  border-radius: 999px;
+  font-size: .75rem;
+  font-weight: 800;
+  background: #e8f1e4;
+  color: var(--forest);
+}
+.badge.completed { background: #d8f5d0 }
+.badge.cancelled { background: #f6dede; color: #8a2020 }
+
+/* ---------- footer ---------- */
+.footer { background: #0d2c22; color: #dfe9e2; padding: 4rem 0 6rem }
+.footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 2rem }
+
+/* ---------- admin ---------- */
+.admin-shell { display: grid; grid-template-columns: 250px 1fr; min-height: 100vh; background: var(--cream) }
+.sidebar { display: grid; align-content: start; gap: .5rem; background: #102e24; color: #fff; padding: 2rem 1rem }
+.sidebar a { display: block; padding: .65rem; border-radius: .5rem }
+.sidebar a:hover { background: #214b3b }
+.admin-main { padding: 2rem; max-width: 1200px; width: 100%; overflow: auto }
+
+/* ---------- floating SMS widget (fallback styles) ---------- */
+.sms-widget { position: fixed; right: 1.5rem; bottom: 1.5rem; z-index: 50 }
+.sms-widget__card { max-width: 260px }
+
+/* ---------- mobile sticky action bar ---------- */
+.sticky-actions { display: none }
+
+/* ---------- responsive ---------- */
+@media (max-width: 900px) {
+  .navlinks { display: none }
+  .mobile-menu { display: block }
+  .hero-grid { grid-template-columns: 1fr; min-height: auto; padding: 4rem 0 }
+  .hero-art { min-height: 300px }
+  .hero-note { margin-left: 0 }
+  .footer-grid, .admin-shell { grid-template-columns: 1fr }
+  .sidebar { display: flex; gap: .4rem; overflow: auto; padding: 1rem }
+  .sidebar a { white-space: nowrap }
+  .admin-main { padding: 1rem }
+}
+
+@media (max-width: 600px) {
+  .section { padding: 3.5rem 0 }
+  .header .btn-light { display: none }
+  .sticky-actions {
+    position: fixed;
+    bottom: 0;
+    left: 0;
+    z-index: 60;
+    display: grid;
+    grid-template-columns: repeat(3, 1fr);
+    background: #fff;
+    border-top: 1px solid #ddd;
+    width: 100%;
+    padding: .5rem;
+  }
+  .sticky-actions a { text-align: center; padding: .55rem; font-size: .8rem; font-weight: 800 }
+  .footer { padding-bottom: 7rem }
+  .gallery-photo, .upload-fields { grid-column: span 12; grid-template-columns: 1fr }
+  .gallery-photo:nth-child(2) { transform: none }
+  .title { font-size: clamp(2.2rem, 11vw, 3.6rem) }
+  .sms-widget { right: 1rem; bottom: 4.75rem }
+  .sms-widget__card { max-width: calc(100vw - 2rem) }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  * { scroll-behavior: auto !important; transition: none !important }
+}
