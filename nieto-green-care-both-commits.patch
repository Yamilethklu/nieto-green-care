+import {NextRequest, NextResponse} from "next/server";
+import {leadSchema, fieldErrors, normalizeEmail, normalizePhone} from "@/lib/validation";
+import {adminDb} from "@/lib/supabase/server";
+import {calculatePrice} from "@/lib/pricing";
+import type {PricingRule} from "@/types";
+import {Resend} from "resend";
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const isDate = (x: string) => /^\d{4}-\d{2}-\d{2}$/.test(x);
+
+export async function POST(req: NextRequest) {
+  const db = adminDb();
+  if (!db) {
+    return NextResponse.json(
+      {error: "Online requests are not configured yet. Please call 737-314-4215."},
+      {status: 503}
+    );
+  }
+
+  let raw: unknown;
+  try {
+    raw = await req.json();
+  } catch {
+    return NextResponse.json({error: "Malformed request body."}, {status: 400});
+  }
+
+  const parsed = leadSchema.safeParse(raw);
+  if (!parsed.success) {
+    const fields = fieldErrors(parsed.error);
+    return NextResponse.json(
+      {
+        error: "Please review the highlighted fields.",
+        fields,
+        // Human-readable list so the UI can show exactly what is missing.
+        detail: Object.entries(fields).map(([k, v]) => `${k}: ${v}`),
+      },
+      {status: 400}
+    );
+  }
+
+  const input = parsed.data;
+  if (input.website) return NextResponse.json({ok: true});
+
+  // A service_id coming from the offline fallback catalogue is not a UUID and
+  // must not be sent to a uuid/foreign-key column.
+  const serviceId = UUID.test(input.service_id) ? input.service_id : null;
+
+  let estimate: number | null = null;
+  if (serviceId && input.lawn_sqft > 0) {
+    const {data: rules} = await db
+      .from("pricing_rules")
+      .select("service_id,min_sqft,max_sqft,price,frequency,active")
+      .eq("service_id", serviceId)
+      .eq("active", true);
+    estimate = calculatePrice(serviceId, input.lawn_sqft, input.frequency, (rules || []) as PricingRule[]);
+  }
+
+  // Everything the `leads` table does not have a column for is preserved in
+  // `details` (jsonb) instead of being dropped or breaking the insert.
+  const details = {
+    first_name: input.first_name,
+    last_name: input.last_name,
+    postal_code: input.postal_code,
+    property_occupancy: input.property_occupancy,
+    mow_area: input.mow_area,
+    is_corner_lot: input.is_corner_lot,
+    grass_over_6in: input.grass_over_6in,
+    grass_over_12in: input.grass_over_12in,
+    community_gate: input.community_gate,
+    backyard_gate: input.backyard_gate,
+    flower_beds: input.flower_beds,
+    pets_in_backyard: input.pets_in_backyard,
+    white_vinyl_fence: input.white_vinyl_fence,
+    above_ground_pool: input.above_ground_pool,
+    trampoline: input.trampoline,
+    optional_services: input.optional_services,
+    referral_source: input.referral_source,
+    special_requests: input.special_requests,
+    payment_preference: input.payment_preference,
+    service_slug_or_id: input.service_id,
+  };
+
+  const row = {
+    full_name: input.full_name,
+    email: input.email || null,
+    phone: input.phone,
+    email_normalized: input.email ? normalizeEmail(input.email) : null,
+    phone_normalized: normalizePhone(input.phone),
+    property_address: input.property_address,
+    latitude: input.latitude,
+    longitude: input.longitude,
+    lawn_sqft: input.lawn_sqft || null,
+    lawn_geometry: input.lawn_geometry,
+    service_id: serviceId,
+    requested_date: isDate(input.requested_date) ? input.requested_date : null,
+    requested_time: input.requested_time || null,
+    frequency: input.frequency,
+    waste_handling: input.waste_handling || null,
+    notes: [input.notes, input.special_requests].filter(Boolean).join("\n\n") || null,
+    payment_method: input.payment_method,
+    estimated_price: estimate,
+    status: "scheduled" as const,
+    details,
+  };
+
+  let {data, error} = await db.from("leads").insert(row).select("id").single();
+
+  // If the `details` column has not been migrated yet, retry without it rather
+  // than failing the customer's request.
+  if (error && /details/i.test(error.message || "")) {
+    const fallbackRow: Record<string, unknown> = {...row};
+    delete fallbackRow.details;
+    ({data, error} = await db.from("leads").insert(fallbackRow).select("id").single());
+  }
+
+  if (error || !data) {
+    console.error("Lead insert failed", error?.code, error?.message);
+    return NextResponse.json(
+      {error: "We could not save the request. Please call us at 737-314-4215."},
+      {status: 500}
+    );
+  }
+
+  if (process.env.RESEND_API_KEY && process.env.EMAIL_TO && process.env.EMAIL_FROM) {
+    new Resend(process.env.RESEND_API_KEY).emails
+      .send({
+        from: process.env.EMAIL_FROM,
+        to: process.env.EMAIL_TO,
+        subject: "New Nieto Green Care request",
+        text: `New request from ${input.full_name}
+${input.property_address}
+${input.phone}
+Requested: ${input.requested_date || "flexible"} ${input.requested_time || ""}`.trim(),
+      })
+      .catch((e) => console.error("Booking email failed", e instanceof Error ? e.message : "unknown"));
+  }
+
+  return NextResponse.json({id: data.id, estimated_price: estimate}, {status: 201});
+}
