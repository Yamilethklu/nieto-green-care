diff --git a/app/admin/(dashboard)/leads/page.tsx b/app/admin/(dashboard)/leads/page.tsx
new file mode 100644
index 0000000..e8763c7
--- /dev/null
+++ b/app/admin/(dashboard)/leads/page.tsx
@@ -0,0 +1,83 @@
+import {redirect} from "next/navigation";
+import {requireAdmin} from "@/lib/supabase/auth";
+import {LeadStatusSelect} from "@/components/admin/LeadStatusSelect";
+
+type Lead = {
+  id: string;
+  full_name: string | null;
+  phone: string | null;
+  email: string | null;
+  property_address: string | null;
+  lawn_sqft: number | null;
+  frequency: string | null;
+  requested_date: string | null;
+  estimated_price: number | null;
+  status: string;
+  created_at: string;
+};
+
+export default async function Page() {
+  const auth = await requireAdmin();
+  if (!auth) redirect("/admin/login");
+
+  const {data, error} = await auth.db
+    .from("leads")
+    .select(
+      "id,full_name,phone,email,property_address,lawn_sqft,frequency,requested_date,estimated_price,status,created_at"
+    )
+    .order("created_at", {ascending: false})
+    .limit(200);
+
+  const leads = (data || []) as Lead[];
+
+  return (
+    <>
+      <h1>Leads</h1>
+      <p className="notice">Change a status to move a request through scheduled → completed or cancelled.</p>
+
+      {error && <div className="empty">Unable to load leads right now.</div>}
+
+      {!error && leads.length === 0 && <div className="empty">No requests yet.</div>}
+
+      {leads.length > 0 && (
+        <table className="table">
+          <thead>
+            <tr>
+              <th>Received</th>
+              <th>Customer</th>
+              <th>Contact</th>
+              <th>Address</th>
+              <th>Service details</th>
+              <th>Estimate</th>
+              <th>Status</th>
+            </tr>
+          </thead>
+          <tbody>
+            {leads.map((lead) => (
+              <tr key={lead.id}>
+                <td>{new Date(lead.created_at).toLocaleDateString()}</td>
+                <td>{lead.full_name || "—"}</td>
+                <td>
+                  {lead.phone && <div>{lead.phone}</div>}
+                  {lead.email && <div className="muted">{lead.email}</div>}
+                </td>
+                <td>{lead.property_address || "—"}</td>
+                <td>
+                  <div>{lead.frequency || "one_time"}</div>
+                  <div className="muted">
+                    {lead.lawn_sqft ? `${Math.round(lead.lawn_sqft).toLocaleString()} sq ft` : "Measure on site"}
+                    {lead.requested_date ? ` · ${lead.requested_date}` : ""}
+                  </div>
+                </td>
+                <td>{lead.estimated_price != null ? `$${Number(lead.estimated_price).toFixed(2)}` : "Custom"}</td>
+                <td>
+                  <LeadStatusSelect id={lead.id} status={lead.status} />
+                </td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      )}
+    </>
+  );
+}
