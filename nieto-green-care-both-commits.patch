+"use server";
+
+import {revalidatePath} from "next/cache";
+import {requireAdmin} from "@/lib/supabase/auth";
+
+const STATUSES = ["scheduled", "completed", "cancelled"] as const;
+type Status = (typeof STATUSES)[number];
+
+export type ActionResult = {ok: boolean; message: string};
+
+export async function updateLeadStatus(id: string, status: string): Promise<ActionResult> {
+  const auth = await requireAdmin();
+  if (!auth) return {ok: false, message: "Not authorized."};
+  if (!STATUSES.includes(status as Status)) return {ok: false, message: "Unknown status."};
+
+  const {error} = await auth.db.from("leads").update({status}).eq("id", id);
+  if (error) {
+    console.error("Lead status update failed", error.code, error.message);
+    return {ok: false, message: "Could not update this request."};
+  }
+
+  revalidatePath("/admin");
+  revalidatePath("/admin/leads");
+  return {ok: true, message: "Status updated."};
+}
+
+export async function saveCapacity(day: string, maxJobs: number, notes: string): Promise<ActionResult> {
+  const auth = await requireAdmin();
+  if (!auth) return {ok: false, message: "Not authorized."};
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(day)) return {ok: false, message: "Pick a valid date."};
+  if (!Number.isFinite(maxJobs) || maxJobs < 0) return {ok: false, message: "Max jobs must be zero or more."};
+
+  const {error} = await auth.db
+    .from("schedule_capacity")
+    .upsert({day, max_jobs: Math.floor(maxJobs), notes: notes || null}, {onConflict: "day"});
+
+  if (error) {
+    console.error("Capacity upsert failed", error.code, error.message);
+    return {
+      ok: false,
+      message: /schedule_capacity/i.test(error.message || "")
+        ? "Run migration 002 to create the schedule_capacity table."
+        : "Could not save capacity.",
+    };
+  }
+
+  revalidatePath("/admin/schedule");
+  return {ok: true, message: "Capacity saved."};
+}
+
+export async function deleteCapacity(id: string): Promise<ActionResult> {
+  const auth = await requireAdmin();
+  if (!auth) return {ok: false, message: "Not authorized."};
+
+  const {error} = await auth.db.from("schedule_capacity").delete().eq("id", id);
+  if (error) return {ok: false, message: "Could not remove this day."};
+
+  revalidatePath("/admin/schedule");
+  return {ok: true, message: "Day removed."};
+}
