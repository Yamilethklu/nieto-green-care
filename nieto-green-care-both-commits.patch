+"use client";
+
+import {useState, useTransition} from "react";
+import {saveCapacity, deleteCapacity} from "@/app/admin/actions";
+
+export function CapacityForm() {
+  const [day, setDay] = useState(new Date().toISOString().slice(0, 10));
+  const [maxJobs, setMaxJobs] = useState("4");
+  const [notes, setNotes] = useState("");
+  const [message, setMessage] = useState("");
+  const [ok, setOk] = useState(true);
+  const [pending, startTransition] = useTransition();
+
+  return (
+    <div className="card upload-form">
+      <div className="upload-fields">
+        <div className="field">
+          <label htmlFor="cap-day">Day</label>
+          <input id="cap-day" type="date" className="input" value={day} onChange={(e) => setDay(e.target.value)} />
+        </div>
+        <div className="field">
+          <label htmlFor="cap-max">Max jobs</label>
+          <input
+            id="cap-max"
+            type="number"
+            min={0}
+            className="input"
+            value={maxJobs}
+            onChange={(e) => setMaxJobs(e.target.value)}
+          />
+        </div>
+      </div>
+      <div className="field">
+        <label htmlFor="cap-notes">Notes</label>
+        <input id="cap-notes" className="input" value={notes} onChange={(e) => setNotes(e.target.value)} />
+      </div>
+      <button
+        type="button"
+        className="btn btn-primary"
+        disabled={pending}
+        onClick={() =>
+          startTransition(async () => {
+            const result = await saveCapacity(day, Number(maxJobs), notes);
+            setOk(result.ok);
+            setMessage(result.message);
+          })
+        }
+      >
+        {pending ? "Saving…" : "Save capacity"}
+      </button>
+      {message && <p className={ok ? "muted" : "field-error"}>{message}</p>}
+    </div>
+  );
+}
+
+export function CapacityDelete({id}: {id: string}) {
+  const [pending, startTransition] = useTransition();
+  const [message, setMessage] = useState("");
+
+  return (
+    <>
+      <button
+        type="button"
+        className="btn btn-light"
+        disabled={pending}
+        onClick={() =>
+          startTransition(async () => {
+            const result = await deleteCapacity(id);
+            if (!result.ok) setMessage(result.message);
+          })
+        }
+      >
+        Remove
+      </button>
+      {message && <span className="field-error">{message}</span>}
+    </>
+  );
+}
diff --git a/components/admin/LeadStatusSelect.tsx b/components/admin/LeadStatusSelect.tsx
new file mode 100644
index 0000000..01088a8
--- /dev/null
+++ b/components/admin/LeadStatusSelect.tsx
@@ -0,0 +1,45 @@
+"use client";
+
+import {useState, useTransition} from "react";
+import {updateLeadStatus} from "@/app/admin/actions";
+
+const OPTIONS = ["scheduled", "completed", "cancelled"] as const;
+
+export function LeadStatusSelect({id, status}: {id: string; status: string}) {
+  const [value, setValue] = useState(status);
+  const [message, setMessage] = useState("");
+  const [pending, startTransition] = useTransition();
+
+  return (
+    <span style={{display: "inline-flex", gap: ".5rem", alignItems: "center"}}>
+      <select
+        className="input"
+        style={{width: "auto", padding: ".4rem .6rem"}}
+        value={value}
+        disabled={pending}
+        aria-label="Lead status"
+        onChange={(e) => {
+          const nextValue = e.target.value;
+          const previous = value;
+          setValue(nextValue);
+          setMessage("");
+          startTransition(async () => {
+            const result = await updateLeadStatus(id, nextValue);
+            if (!result.ok) {
+              setValue(previous);
+              setMessage(result.message);
+            }
+          });
+        }}
+      >
+        {OPTIONS.map((o) => (
+          <option key={o} value={o}>
+            {o}
+          </option>
+        ))}
+      </select>
+      {pending && <span className="muted">…</span>}
+      {message && <span className="field-error">{message}</span>}
+    </span>
+  );
+}
