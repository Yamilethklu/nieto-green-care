+import {redirect} from "next/navigation";
+import {requireAdmin} from "@/lib/supabase/auth";
+import {CapacityForm, CapacityDelete} from "@/components/admin/CapacityForm";
+
+type Capacity = {
+  id: string;
+  day: string;
+  max_jobs: number;
+  booked_jobs: number;
+  notes: string | null;
+};
+
+export default async function Page() {
+  const auth = await requireAdmin();
+  if (!auth) redirect("/admin/login");
+
+  const today = new Date().toISOString().slice(0, 10);
+  const {data, error} = await auth.db
+    .from("schedule_capacity")
+    .select("id,day,max_jobs,booked_jobs,notes")
+    .gte("day", today)
+    .order("day")
+    .limit(90);
+
+  const rows = (data || []) as Capacity[];
+
+  return (
+    <>
+      <h1>Schedule capacity</h1>
+      <p className="notice">Set how many jobs can be booked on a given day. Saving an existing day updates it.</p>
+
+      <CapacityForm />
+
+      {error && (
+        <div className="empty">
+          Unable to read schedule_capacity. Run migration 002 in Supabase, then reload this page.
+        </div>
+      )}
+
+      {!error && rows.length === 0 && <div className="empty">No capacity set for upcoming days.</div>}
+
+      {rows.length > 0 && (
+        <table className="table">
+          <thead>
+            <tr>
+              <th>Day</th>
+              <th>Booked</th>
+              <th>Max</th>
+              <th>Notes</th>
+              <th />
+            </tr>
+          </thead>
+          <tbody>
+            {rows.map((row) => (
+              <tr key={row.id}>
+                <td>{row.day}</td>
+                <td>{row.booked_jobs}</td>
+                <td>{row.max_jobs}</td>
+                <td>{row.notes || "—"}</td>
+                <td>
+                  <CapacityDelete id={row.id} />
+                </td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      )}
+    </>
+  );
+}
