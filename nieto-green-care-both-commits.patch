+import Link from "next/link";
+import {redirect} from "next/navigation";
+import {requireAdmin} from "@/lib/supabase/auth";
+
+export default async function Page() {
+  const auth = await requireAdmin();
+  if (!auth) redirect("/admin/login");
+
+  const {data} = await auth.db
+    .from("leads")
+    .select("id,status,full_name,property_address,created_at")
+    .order("created_at", {ascending: false})
+    .limit(50);
+
+  const leads = data || [];
+  const count = (s: string) => leads.filter((x) => x.status === s).length;
+  const tiles: [string, number][] = [
+    ["Total leads", leads.length],
+    ["Scheduled", count("scheduled")],
+    ["Completed", count("completed")],
+    ["Cancelled", count("cancelled")],
+  ];
+
+  return (
+    <>
+      <h1>Overview</h1>
+      <div className="grid cards">
+        {tiles.map(([label, value]) => (
+          <div className="card" key={label}>
+            <span className="eyebrow">{label}</span>
+            <h2>{value}</h2>
+          </div>
+        ))}
+      </div>
+
+      <h2>Recent requests</h2>
+      {leads.length ? (
+        <>
+          <table className="table">
+            <thead>
+              <tr>
+                <th>Customer</th>
+                <th>Address</th>
+                <th>Status</th>
+                <th>Received</th>
+              </tr>
+            </thead>
+            <tbody>
+              {leads.slice(0, 8).map((x) => (
+                <tr key={x.id}>
+                  <td>{x.full_name || "—"}</td>
+                  <td>{x.property_address || "—"}</td>
+                  <td>
+                    <span className={`badge ${x.status}`}>{x.status}</span>
+                  </td>
+                  <td>{new Date(x.created_at).toLocaleDateString()}</td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+          <p style={{marginTop: "1rem"}}>
+            <Link className="btn btn-light" href="/admin/leads">
+              Manage all leads
+            </Link>
+          </p>
+        </>
+      ) : (
+        <div className="empty">No lead data yet.</div>
+      )}
+    </>
+  );
+}
