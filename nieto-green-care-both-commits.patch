+"use client";
+
+import dynamic from "next/dynamic";
+import {useCallback, useEffect, useState} from "react";
+import type {Locale, Service, Frequency} from "@/types";
+import type {MapValue} from "./LawnMap";
+import {calendarUrl, smsUrl, type BookingSummary} from "@/lib/integrations";
+import {BUSINESS} from "@/lib/config";
+
+const LawnMap = dynamic(() => import("./LawnMap"), {
+  ssr: false,
+  loading: () => <div className="notice">Loading satellite map…</div>,
+});
+
+type GeoResult = {display_name: string; lat: string; lon: string};
+
+const emptyGeo: GeoJSON.FeatureCollection = {type: "FeatureCollection", features: []};
+const STEPS = 6;
+
+export function QuoteWizard({locale, services}: {locale: Locale; services: Service[]}) {
+  const es = locale === "es";
+  const [step, setStep] = useState(1);
+  const [query, setQuery] = useState("");
+  const [results, setResults] = useState<GeoResult[]>([]);
+  const [searching, setSearching] = useState(false);
+  const [submitting, setSubmitting] = useState(false);
+  const [errors, setErrors] = useState<Record<string, string>>({});
+  const [formError, setFormError] = useState("");
+  const [done, setDone] = useState<BookingSummary | null>(null);
+
+  const [form, setForm] = useState({
+    address: "",
+    lat: 0,
+    lng: 0,
+    sqft: 0,
+    geometry: emptyGeo,
+    service_id: "",
+    frequency: "one_time" as Frequency,
+    date: "",
+    time: "",
+    name: "",
+    email: "",
+    phone: "",
+    payment: "cash",
+    notes: "",
+    website: "",
+  });
+
+  // Address autocomplete. Failure here is never fatal: the typed text is kept.
+  useEffect(() => {
+    if (query.trim().length < 4 || form.address === query) return;
+    const controller = new AbortController();
+    const timer = setTimeout(async () => {
+      setSearching(true);
+      try {
+        const r = await fetch(`/api/geocode?q=${encodeURIComponent(query)}`, {signal: controller.signal});
+        setResults(r.ok ? await r.json() : []);
+      } catch {
+        setResults([]);
+      } finally {
+        setSearching(false);
+      }
+    }, 600);
+    return () => {
+      clearTimeout(timer);
+      controller.abort();
+    };
+  }, [query, form.address]);
+
+  const measure = useCallback((v: MapValue) => setForm((f) => ({...f, sqft: v.sqft, geometry: v.geometry})), []);
+
+  const selected = services.find((s) => s.id === form.service_id);
+  const next = () => setStep((x) => Math.min(STEPS, x + 1));
+  const back = () => setStep((x) => Math.max(1, x - 1));
+
+  /** Accept whatever the customer typed, even if OSM returned no coordinates. */
+  const acceptTypedAddress = () => {
+    setForm((f) => ({...f, address: query.trim()}));
+    setResults([]);
+  };
+
+  async function submit() {
+    setSubmitting(true);
+    setErrors({});
+    setFormError("");
+
+    const address = form.address || query.trim();
+    const payload = {
+      full_name: form.name,
+      email: form.email,
+      phone: form.phone,
+      property_address: address,
+      latitude: form.lat || null,
+      longitude: form.lng || null,
+      lawn_sqft: form.sqft,
+      lawn_geometry: form.geometry,
+      service_id: form.service_id,
+      requested_date: form.date,
+      requested_time: form.time,
+      frequency: form.frequency,
+      notes: form.notes,
+      payment_method: form.payment,
+      website: form.website,
+    };
+
+    try {
+      const r = await fetch("/api/leads", {
+        method: "POST",
+        headers: {"content-type": "application/json"},
+        body: JSON.stringify(payload),
+      });
+      const body = await r.json().catch(() => ({}));
+
+      if (!r.ok) {
+        setErrors(body.fields || {});
+        setFormError(
+          body.error ||
+            (es ? "No pudimos enviar la solicitud. Intente de nuevo." : "We could not send the request. Please try again.")
+        );
+        // Send the customer back to the step that owns the first failing field.
+        const first = Object.keys(body.fields || {})[0];
+        if (first === "property_address") setStep(1);
+        else if (first === "service_id") setStep(3);
+        else if (first === "full_name" || first === "phone" || first === "email") setStep(5);
+        return;
+      }
+
+      setDone({
+        name: form.name,
+        service: (es ? selected?.name_es : selected?.name_en) || "Service",
+        address,
+        sqft: form.sqft,
+        estimate: body.estimated_price,
+        date: form.date,
+        time: form.time,
+        frequency: form.frequency,
+        payment: form.payment,
+      });
+      setStep(7);
+    } catch {
+      setFormError(
+        es
+          ? `Problema de red. Llámenos al ${BUSINESS.displayPhone}.`
+          : `Network problem. Please call us at ${BUSINESS.displayPhone}.`
+      );
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
+  if (done && step === 7) {
+    return (
+      <div className="card">
+        <div className="eyebrow">{es ? "Solicitud recibida" : "Request received"}</div>
+        <h2 className="section-title">{es ? "Gracias. Revisaremos los detalles." : "Thank you. We'll review the details."}</h2>
+        <p className="muted">
+          {es
+            ? "La solicitud fue guardada; el servicio aún requiere confirmación humana."
+            : "Your request was saved; service still requires human confirmation."}
+        </p>
+        <div className="actions">
+          <a className="btn btn-accent" href={smsUrl(done)}>{es ? "Enviar resumen por SMS" : "Text request summary"}</a>
+          <a className="btn btn-light" target="_blank" rel="noreferrer" href={calendarUrl(done)}>
+            {es ? "Añadir a Google Calendar" : "Add to Google Calendar"}
+          </a>
+          <button
+            className="btn btn-light"
+            onClick={() => navigator.clipboard?.writeText(`${done.service} — ${done.address}`)}
+          >
+            {es ? "Copiar detalles" : "Copy details"}
+          </button>
+        </div>
+        <p className="muted">SMS: {BUSINESS.displayPhone}</p>
+      </div>
+    );
+  }
+
+  const addressReady = Boolean(form.address || query.trim().length >= 5);
+
+  return (
+    <div className="card">
+      <div className="progress" aria-label={`Step ${step} of ${STEPS}`}>
+        {Array.from({length: STEPS}, (_, i) => (
+          <span className={i + 1 <= step ? "on" : ""} key={i} />
+        ))}
+      </div>
+
+      {formError && <div className="form-error" role="alert">{formError}</div>}
+
+      {step === 1 && (
+        <div className="field">
+          <label htmlFor="address">{es ? "Dirección de la propiedad" : "Property address"}</label>
+          <input
+            id="address"
+            className="input"
+            value={query}
+            onChange={(e) => {
+              setQuery(e.target.value);
+              setForm((f) => ({...f, address: "", lat: 0, lng: 0}));
+            }}
+            autoComplete="street-address"
+            placeholder="123 Main St, Hutto, TX"
+          />
+          {searching && <span aria-live="polite" className="muted">{es ? "Buscando…" : "Searching…"}</span>}
+          {results.map((r) => (
+            <button
+              type="button"
+              className="input"
+              key={`${r.lat}${r.lon}`}
+              onClick={() => {
+                setForm((f) => ({...f, address: r.display_name, lat: +r.lat, lng: +r.lon}));
+                setQuery(r.display_name);
+                setResults([]);
+              }}
+            >
+              {r.display_name}
+            </button>
+          ))}
+          {!searching && query.trim().length >= 5 && !form.address && (
+            <button type="button" className="btn btn-light" onClick={acceptTypedAddress}>
+              {es ? `Usar "${query.trim()}" tal como se escribió` : `Use "${query.trim()}" as typed`}
+            </button>
+          )}
+          {errors.property_address && <span className="field-error">{errors.property_address}</span>}
+          <p className="muted">
+            {es
+              ? "Si no encontramos su dirección en el mapa, puede continuar con el texto escrito."
+              : "If we can't find your address on the map, you can continue with the address as typed."}
+          </p>
+        </div>
+      )}
+
+      {step === 2 && (
+        <>
+          <h2 className="section-title">{es ? "Medición satelital" : "Satellite lawn measurement"}</h2>
+          {form.lat ? (
+            <LawnMap lat={form.lat} lng={form.lng} onChange={measure} />
+          ) : (
+            <div className="notice">
+              {es
+                ? "No tenemos coordenadas para esta dirección, así que la medición satelital no está disponible. Puede continuar y la mediremos en sitio."
+                : "We don't have coordinates for this address, so satellite measuring isn't available. You can continue — we'll measure on site."}
+            </div>
+          )}
+          <h3>
+            {es ? "ÁREA TOTAL" : "TOTAL LAWN AREA"}: {Math.round(form.sqft).toLocaleString()} SQ FT
+          </h3>
+        </>
+      )}
+
+      {step === 3 && (
+        <div className="field">
+          <label htmlFor="service">{es ? "Servicio" : "Service"}</label>
+          <select
+            id="service"
+            className="input"
+            value={form.service_id}
+            onChange={(e) => setForm({...form, service_id: e.target.value})}
+          >
+            <option value="">{es ? "Seleccione…" : "Select…"}</option>
+            {services.map((s) => (
+              <option value={s.id} key={s.id}>
+                {es ? s.name_es : s.name_en}
+              </option>
+            ))}
+          </select>
+          {errors.service_id && <span className="field-error">{errors.service_id}</span>}
+          <label htmlFor="frequency">{es ? "Frecuencia" : "Frequency"}</label>
+          <select
+            id="frequency"
+            className="input"
+            value={form.frequency}
+            onChange={(e) => setForm({...form, frequency: e.target.value as Frequency})}
+          >
+            <option value="one_time">{es ? "Una vez" : "One time"}</option>
+            <option value="weekly">{es ? "Semanal" : "Weekly"}</option>
+            <option value="biweekly">{es ? "Quincenal" : "Biweekly"}</option>
+            <option value="monthly">{es ? "Mensual" : "Monthly"}</option>
+          </select>
+          <p className="notice">
+            {es
+              ? "El precio se calcula con reglas administrativas. Si no hay una regla, recibirá una cotización personalizada."
+              : "Pricing is calculated from admin-managed rules. If no rule matches, you'll receive a custom quote."}
+          </p>
+        </div>
+      )}
+
+      {step === 4 && (
+        <div className="grid cards">
+          <div className="field">
+            <label htmlFor="date">{es ? "Fecha preferida" : "Preferred date"}</label>
+            <input
+              id="date"
+              type="date"
+              min={new Date().toISOString().slice(0, 10)}
+              className="input"
+              value={form.date}
+              onChange={(e) => setForm({...form, date: e.target.value})}
+            />
+          </div>
+          <div className="field">
+            <label htmlFor="time">{es ? "Hora preferida" : "Preferred time"}</label>
+            <input
+              id="time"
+              type="time"
+              className="input"
+              value={form.time}
+              onChange={(e) => setForm({...form, time: e.target.value})}
+            />
+          </div>
+          <p className="muted">{es ? "Opcional — podemos coordinarlo después." : "Optional — we can coordinate later."}</p>
+        </div>
+      )}
+
+      {step === 5 && (
+        <div className="grid">
+          <input
+            aria-hidden="true"
+            tabIndex={-1}
+            autoComplete="off"
+            style={{position: "absolute", left: "-9999px"}}
+            value={form.website}
+            onChange={(e) => setForm({...form, website: e.target.value})}
+          />
+          {([
+            ["name", es ? "Nombre completo" : "Full name", "text", true],
+            ["email", es ? "Correo (opcional)" : "Email (optional)", "email", false],
+            ["phone", es ? "Teléfono" : "Phone", "tel", true],
+          ] as const).map(([k, label, type, required]) => {
+            const errKey = k === "name" ? "full_name" : k;
+            return (
+              <div className="field" key={k}>
+                <label htmlFor={k}>{label}</label>
+                <input
+                  id={k}
+                  required={required}
+                  type={type}
+                  className="input"
+                  value={form[k]}
+                  onChange={(e) => setForm({...form, [k]: e.target.value})}
+                />
+                {errors[errKey] && <span className="field-error">{errors[errKey]}</span>}
+              </div>
+            );
+          })}
+          <div className="field">
+            <label htmlFor="payment">{es ? "Preferencia de pago" : "Payment preference"}</label>
+            <select
+              id="payment"
+              className="input"
+              value={form.payment}
+              onChange={(e) => setForm({...form, payment: e.target.value})}
+            >
+              <option value="cash">{es ? "Efectivo" : "Cash"}</option>
+              <option value="transfer">{es ? "Transferencia" : "Transfer"}</option>
+            </select>
+          </div>
+          <div className="field">
+            <label htmlFor="notes">{es ? "Notas" : "Notes"}</label>
+            <textarea
+              id="notes"
+              className="input"
+              rows={4}
+              value={form.notes}
+              onChange={(e) => setForm({...form, notes: e.target.value})}
+            />
+          </div>
+        </div>
+      )}
+
+      {step === 6 && (
+        <div>
+          <h2 className="section-title">{es ? "Revise su solicitud" : "Review your request"}</h2>
+          <dl className="review-list">
+            <dt>{es ? "Dirección" : "Address"}</dt>
+            <dd>{form.address || query.trim() || "—"}</dd>
+            <dt>{es ? "Área de césped" : "Lawn size"}</dt>
+            <dd>{form.sqft ? `${Math.round(form.sqft).toLocaleString()} sq ft` : es ? "Se medirá en sitio" : "Measured on site"}</dd>
+            <dt>{es ? "Servicio" : "Service"}</dt>
+            <dd>{selected ? (es ? selected.name_es : selected.name_en) : "—"}</dd>
+            <dt>{es ? "Frecuencia" : "Frequency"}</dt>
+            <dd>{form.frequency}</dd>
+            <dt>{es ? "Fecha / hora" : "Date / time"}</dt>
+            <dd>{form.date || form.time ? `${form.date} ${form.time}`.trim() : es ? "Flexible" : "Flexible"}</dd>
+            <dt>{es ? "Estimado" : "Estimate"}</dt>
+            <dd>{es ? "Se verificará al enviar" : "Calculated securely on submission"}</dd>
+            <dt>{es ? "Pago" : "Payment"}</dt>
+            <dd>{form.payment}</dd>
+          </dl>
+          {Object.keys(errors).length > 0 && (
+            <ul className="field-error">
+              {Object.entries(errors).map(([k, v]) => (
+                <li key={k}>{`${k}: ${v}`}</li>
+              ))}
+            </ul>
+          )}
+        </div>
+      )}
+
+      <div className="actions" style={{marginTop: "2rem"}}>
+        {step > 1 && (
+          <button type="button" className="btn btn-light" onClick={back}>
+            {es ? "Atrás" : "Back"}
+          </button>
+        )}
+        {step < STEPS ? (
+          <button
+            type="button"
+            className="btn btn-primary"
+            disabled={(step === 1 && !addressReady) || (step === 3 && !form.service_id)}
+            onClick={() => {
+              if (step === 1 && !form.address) acceptTypedAddress();
+              next();
+            }}
+          >
+            {es ? "Continuar" : "Continue"}
+          </button>
+        ) : (
+          <button type="button" className="btn btn-accent" disabled={submitting} onClick={submit}>
+            {submitting ? (es ? "Enviando…" : "Sending…") : es ? "CONFIRMAR SOLICITUD" : "CONFIRM REQUEST"}
+          </button>
+        )}
+      </div>
+    </div>
+  );
+}
diff --git a/lib/lead-schema.test.ts b/lib/lead-schema.test.ts
new file mode 100644
index 0000000..5ab5914
--- /dev/null
+++ b/lib/lead-schema.test.ts
@@ -0,0 +1,40 @@
+import {describe, expect, it} from "vitest";
+import {leadSchema} from "./validation";
+
+const minimum = {
+  full_name: "Jane Doe",
+  phone: "(737) 314-4215",
+  property_address: "1 Main St, Hutto, TX",
+  service_id: "1",
+};
+
+describe("lead schema is not a submission blocker", () => {
+  it("accepts a lead with only the four essential fields", () => {
+    const parsed = leadSchema.safeParse(minimum);
+    expect(parsed.success).toBe(true);
+  });
+
+  it("accepts a non-uuid service id from the offline fallback catalogue", () => {
+    expect(leadSchema.safeParse({...minimum, service_id: "lawn-mowing"}).success).toBe(true);
+  });
+
+  it("nulls out missing or out-of-range coordinates instead of failing", () => {
+    const parsed = leadSchema.parse({...minimum, latitude: 0, longitude: 0});
+    expect(parsed.latitude).toBeNull();
+    expect(parsed.longitude).toBeNull();
+  });
+
+  it("defaults every optional property question", () => {
+    const parsed = leadSchema.parse(minimum);
+    expect(parsed.lawn_sqft).toBe(0);
+    expect(parsed.frequency).toBe("one_time");
+    expect(parsed.payment_method).toBe("cash");
+    expect(parsed.is_corner_lot).toBe(false);
+    expect(parsed.optional_services).toEqual([]);
+    expect(parsed.lawn_geometry).toEqual({type: "FeatureCollection", features: []});
+  });
+
+  it("still rejects a request with no name, phone, address or service", () => {
+    expect(leadSchema.safeParse({}).success).toBe(false);
+  });
+});
diff --git a/lib/validation.ts b/lib/validation.ts
index 2990950..9f75bd4 100644
--- a/lib/validation.ts
+++ b/lib/validation.ts
@@ -1,3 +1,97 @@
 import {z} from "zod";
-export const leadSchema=z.object({full_name:z.string().trim().min(2).max(100),email:z.string().email().max(254),phone:z.string().regex(/^[+()\-\s\d]{10,20}$/),property_address:z.string().trim().min(8).max(300),latitude:z.number().min(25).max(37),longitude:z.number().min(-107).max(-93),lawn_sqft:z.number().positive().max(5000000),lawn_geometry:z.object({type:z.literal("FeatureCollection"),features:z.array(z.unknown()).max(50)}),service_id:z.string().uuid(),requested_date:z.string().date(),requested_time:z.string().regex(/^\d{2}:\d{2}$/),frequency:z.enum(["one_time","weekly","biweekly","monthly"]),waste_handling:z.string().max(100).optional(),notes:z.string().max(1500).optional(),payment_method:z.enum(["cash","transfer"]),website:z.string().max(0).optional()});
-export const normalizePhone=(x:string)=>x.replace(/\D/g,"").slice(-10);export const normalizeEmail=(x:string)=>x.trim().toLowerCase();
+
+/**
+ * Lead schema.
+ *
+ * Only four things are genuinely required to open a request: a name, a way to
+ * reach the customer (phone), an address, and a service. Everything else is
+ * optional with a safe default, so a missing geocode result or an unanswered
+ * secondary question can never block the submission on the final step.
+ */
+
+const optionalString = (max: number) =>
+  z.preprocess(
+    (v) => (typeof v === "string" ? v.trim() : v === null || v === undefined ? "" : String(v)),
+    z.string().max(max)
+  ).optional().default("");
+
+const optionalBool = z.coerce.boolean().optional().default(false);
+
+/** Latitude/longitude are a convenience, never a gate. Out-of-range or missing => null. */
+const coordinate = (min: number, max: number) =>
+  z.preprocess((v) => {
+    const n = typeof v === "string" ? Number(v) : v;
+    if (typeof n !== "number" || !Number.isFinite(n) || n === 0 || n < min || n > max) return null;
+    return n;
+  }, z.number().nullable()).default(null);
+
+export const featureCollection = z.object({
+  type: z.literal("FeatureCollection"),
+  features: z.array(z.unknown()).max(50),
+});
+
+export const leadSchema = z.object({
+  // --- required ---
+  full_name: z.string().trim().min(2, "Enter the full name").max(100),
+  phone: z.string().trim().regex(/^[+()\-\s\d]{10,20}$/, "Enter a valid phone number"),
+  property_address: z.string().trim().min(5, "Enter the property address").max(300),
+  service_id: z.string().trim().min(1, "Choose a service"),
+
+  // --- optional, always defaulted ---
+  first_name: optionalString(60),
+  last_name: optionalString(60),
+  email: z.preprocess(
+    (v) => (typeof v === "string" ? v.trim() : ""),
+    z.union([z.string().email().max(254), z.literal("")])
+  ).optional().default(""),
+  postal_code: optionalString(12),
+  latitude: coordinate(25, 37),
+  longitude: coordinate(-107, -93),
+  lawn_sqft: z.coerce.number().min(0).max(5_000_000).optional().default(0),
+  lawn_geometry: featureCollection.optional().default({type: "FeatureCollection", features: []}),
+  requested_date: optionalString(20),
+  requested_time: z.preprocess(
+    (v) => (typeof v === "string" ? v.trim() : ""),
+    z.union([z.string().regex(/^\d{2}:\d{2}$/), z.literal("")])
+  ).optional().default(""),
+  frequency: z.enum(["one_time", "weekly", "biweekly", "monthly"]).optional().default("one_time"),
+  waste_handling: optionalString(100),
+  notes: optionalString(1500),
+  special_requests: optionalString(1500),
+  referral_source: optionalString(120),
+  payment_method: z.enum(["cash", "transfer"]).optional().default("cash"),
+  payment_preference: optionalString(40),
+  property_occupancy: optionalString(40),
+  mow_area: optionalString(60),
+  optional_services: z.array(z.string().max(80)).max(30).optional().default([]),
+
+  // --- yes/no property questions: never blocking ---
+  is_corner_lot: optionalBool,
+  grass_over_6in: optionalBool,
+  grass_over_12in: optionalBool,
+  community_gate: optionalBool,
+  backyard_gate: optionalBool,
+  flower_beds: optionalBool,
+  pets_in_backyard: optionalBool,
+  white_vinyl_fence: optionalBool,
+  above_ground_pool: optionalBool,
+  trampoline: optionalBool,
+
+  // honeypot
+  website: z.string().max(0).optional(),
+});
+
+export type LeadInput = z.infer<typeof leadSchema>;
+
+/** Flattens a ZodError into `{ field: message }` so the UI can highlight fields. */
+export function fieldErrors(error: z.ZodError) {
+  const out: Record<string, string> = {};
+  for (const issue of error.issues) {
+    const key = issue.path.join(".") || "form";
+    if (!out[key]) out[key] = issue.message;
+  }
+  return out;
+}
+
+export const normalizePhone = (x: string) => x.replace(/\D/g, "").slice(-10);
+export const normalizeEmail = (x: string) => x.trim().toLowerCase();
diff --git a/supabase/migrations/002_lead_details_and_schedule_capacity.sql b/supabase/migrations/002_lead_details_and_schedule_capacity.sql
new file mode 100644
index 0000000..151e787
--- /dev/null
+++ b/supabase/migrations/002_lead_details_and_schedule_capacity.sql
@@ -0,0 +1,29 @@
+-- Extra, non-blocking answers from the quote funnel (corner lot, gates, pets,
+-- optional services, referral source, …). Kept as jsonb so new funnel questions
+-- never require a schema change or break an insert.
+alter table public.leads add column if not exists details jsonb not null default '{}'::jsonb;
+
+-- Daily capacity used by the admin dashboard to cap how many jobs can be
+-- scheduled per day.
+create table if not exists public.schedule_capacity(
+  id uuid primary key default gen_random_uuid(),
+  day date not null unique,
+  max_jobs integer not null default 0 check (max_jobs >= 0),
+  booked_jobs integer not null default 0 check (booked_jobs >= 0),
+  notes text,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+
+create index if not exists schedule_capacity_day_idx on public.schedule_capacity(day);
+
+drop trigger if exists schedule_capacity_updated on public.schedule_capacity;
+create trigger schedule_capacity_updated
+  before update on public.schedule_capacity
+  for each row execute function public.touch_updated_at();
+
+alter table public.schedule_capacity enable row level security;
+
+drop policy if exists "admins schedule capacity" on public.schedule_capacity;
+create policy "admins schedule capacity" on public.schedule_capacity
+  for all using (public.is_admin()) with check (public.is_admin());
